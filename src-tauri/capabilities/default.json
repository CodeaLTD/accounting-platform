{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-write-file",
    "fs:allow-appdata-read",
    "fs:allow-appdata-write",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://codea-auth-server.onrender.com/*" }]
    }
  ]
}
